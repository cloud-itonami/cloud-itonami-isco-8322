;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a vehicle-telemetry robot performs pre-trip
;; inspection checks and cargo/passenger-area sensing; driving beyond duty
;; hours or accepting a high-risk trip needs human sign-off. The physical
;; work it senses: how a loaded van climbs a steep street (whether the load
;; is within what the vehicle can pull), and how well an insulated cargo body
;; keeps chilled goods cold in the sun.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-8322"
 :cases
 [{:id :loaded-van-up-hill
   :kind :transport
   :procedure "delivery van (2 t kerb) pulls away from a stop and climbs 300 m of a 6 degree street at up to 40 km/h"
   :params {:mass-kg 2000.0 :distance-m 300.0 :v-max-mps 11.1 :a-max-mps2 1.5
            :brake-decel-mps2 3.0 :drive-force-n 4500.0 :crr 0.012 :slope-deg 6.0
            :cog-height-m 0.80 :support-half-length-m 1.60 :max-time-s 1200.0}
   :sweep {:param :payload-kg :values [200.0 500.0 800.0 1100.0 1400.0]}
   :quantity :cycle-time-s
   :limit {:max 60.0 :basis "estimate: a loaded van should clear a 300 m hill in about a minute; slower means an overload for the route"}
   :boundary {:lo 100.0 :hi 1800.0}}
  {:id :chilled-cargo-body-wall
   :kind :thermal
   :procedure "insulated polyurethane cargo-body wall in 60 C sol-air for 3 hours; the cargo side is chilled air at 3 C"
   :params {:conductivity-w-mk 0.025 :density-kg-m3 40.0 :specific-heat-j-kgk 1500.0
            :t0-c 3.0 :t-hot-c 60.0 :h-front-w-m2k 20.0 :t-back-ambient-c 3.0 :h-back-w-m2k 10.0
            :threshold-c 8.0 :duration-s 10800.0 :nodes 21}
   :sweep {:param :thickness-m :values [0.02 0.04 0.06 0.08 0.10]}
   :quantity :peak-back-c
   :limit {:max 8.0 :basis "estimate: inner wall kept at or below the 8 C commonly used as the upper bound for chilled food"}
   :boundary {:lo 0.005 :hi 0.12}}]}
